# 琴小助 AI 后端环境变量示例
# ---------------------------------------------------------------
# 复制本文件为 .env，填入真实 Key 即可在本地启动后端。
# .env 已在 .gitignore 中，永远不会被提交到 Git。

# OpenRouter API Key（必填）
# 从 https://openrouter.ai/keys 获取
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 模型（可选，默认 openrouter/free，便于先免费测试）
# 未来想换模型时只需改这里，无需改代码。
OPENROUTER_MODEL=openrouter/free