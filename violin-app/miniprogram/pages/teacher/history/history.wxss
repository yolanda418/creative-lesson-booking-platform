.container { padding-bottom: 160rpx; }
.month-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx;
  padding: 20rpx;
  background: #E8F1FB;
  border-radius: 12rpx;
}
.month-label {
  color: #4A90E2;
  font-weight: bold;
}
.summary {
  margin: 0 20rpx 20rpx;
  color: #4A90E2;
  font-size: 28rpx;
}
.export-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10;
}
.export-bar .btn-primary {
  width: 100%;
}
