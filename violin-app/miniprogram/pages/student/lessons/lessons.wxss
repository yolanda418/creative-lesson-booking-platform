.container { padding-bottom: 140rpx; }
.switcher {
  display: flex;
  margin: 20rpx;
  background: #E8F1FB;
  border-radius: 12rpx;
  overflow: hidden;
}
.switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  color: #4A90E2;
}
.switch-item.active { background: #4A90E2; color: #fff; }
