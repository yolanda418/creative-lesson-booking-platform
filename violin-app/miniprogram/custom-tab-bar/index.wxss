.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.icon { font-size: 40rpx; }
.text { font-size: 20rpx; color: #A6B3C2; margin-top: 4rpx; }
.text.active { color: #4A90E2; }
